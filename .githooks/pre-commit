#!/usr/bin/env bash
# pre-commit -- fast, runs on every commit.
# Activated via `make install-hooks` (sets core.hooksPath=.githooks).
# Bypass with `git commit --no-verify`.
#
# Two jobs only (the test suite is deferred to pre-push to keep commits quick):
#   1. Auto-bump the patch version when the shipped source (src/**/*.py and .pyi,
#      core/src, core/include, hatch_build.py) changes, so __version__ in src/rulfo/__init__.py -- the single source
#      of truth (pyproject reads it via [tool.hatch.version]) -- advances with every
#      code change. Doc/notes (incl. src/*.md)/test/example/config-only commits do not bump.
#   2. Lint the staged Python with ruff (the same linter CI runs).

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)
[[ ${#staged[@]} -eq 0 ]] && exit 0

# 1. auto-bump patch when the shipped source changed: what is in the wheel. Notes/docs under
#    src/ and the C tests don't trigger a release.
if printf '%s\n' "${staged[@]}" | grep -qE '^(src/.*\.pyi?|core/(src|include)/.*|hatch_build\.py)$'; then
    # ...unless the version line is already moving in this commit. `make bump TYPE=minor`
    # followed by a commit that also touches src/ would otherwise bump twice: once by
    # hand, once here. That silently skips a version, and worse, it turns a deliberate
    # `TYPE=minor` into minor+patch -- 0.6.2 -> 0.7.0 -> 0.7.1, so the version you chose
    # is not the version that ships. The invariant this hook wants is "the version moved",
    # not "this hook moved it".

    # (The version is dynamic, so only src/rulfo/__init__.py moves -- uv.lock is untouched.)
    if git diff --cached -- src/rulfo/__init__.py | grep -qE '^\+__version__ = "'; then
        echo "pre-commit: version already bumped in this commit -- leaving it alone"
    else
        ./scripts/bump-version patch
        git add src/rulfo/__init__.py
    fi
fi

# 2. lint staged Python (fast; pyright + tests run in pre-push)
mapfile -t py < <(printf '%s\n' "${staged[@]}" | grep -E '\.py$' || true)
if [[ ${#py[@]} -gt 0 ]]; then
    uv run ruff check "${py[@]}"
fi

