#!/bin/sh
# Install the wheel of dist/ (or of the folder given) in a new virtualenv on each CPython that
# rulfo supports, send one request between two peers, and check that the module keeps to the
# stable ABI.
set -e
root="$(CDPATH= cd "$(dirname "$0")/.." && pwd)"
folder="${1:-dist}"
set -- "$root/$folder"/rulfo-*.whl
[ "$#" -eq 1 ] && [ -f "$1" ] || { echo "test-wheel: $folder/ must hold one wheel" >&2; exit 1; }
wheel="$1"

for python in 3.12 3.13 3.14 3.15; do
    scratch="$(mktemp -d)"
    uv venv --quiet --python "$python" "$scratch/venv"
    uv pip install --quiet --python "$scratch/venv/bin/python" "$wheel"
    # From another folder, so the source tree is not importable.
    (cd "$scratch" && "$scratch/venv/bin/python" -I "$root/scripts/wheel-smoke.py")
done

# The x86_64 half of a macOS wheel, when this machine can run x86_64 programs (Rosetta).
if [ "$(uname -s)" = Darwin ]; then
    if arch -x86_64 /usr/bin/true 2>/dev/null; then
        scratch="$(mktemp -d)"
        uv venv --quiet --python cpython-3.12-macos-x86_64 "$scratch/venv"
        uv pip install --quiet --python "$scratch/venv/bin/python" "$wheel"
        (cd "$scratch" && "$scratch/venv/bin/python" -I "$root/scripts/wheel-smoke.py")
    else
        echo "test-wheel: no Rosetta here, the x86_64 half is not run"
    fi
fi

uvx abi3audit --strict --report "$wheel" >/dev/null
echo "test-wheel: $(basename "$wheel") passes"
